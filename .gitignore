# D:/ContractReviewSys-合同审批智能审查项目/.gitignore
# =====================================================================
# Git 忽略规则
# 目的：排除依赖、构建产物、运行时数据与敏感配置，保持仓库整洁安全
# =====================================================================

# ------------------------- Python -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ------------------------- 环境变量（含密钥，严禁提交）-------------------------
# 保留 .env.example 作为模板，实际 .env 不入库
.env
.env.local
.env.*.local
!.env.example

# ------------------------- Node / 前端 -------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local
.pnpm-store/

# ------------------------- 运行时数据与日志 -------------------------
storage/logs/
storage/tmp/
storage/minio_data/
storage/milvus_data/
storage/mongo_data/
storage/etcd_data/
*.log

# devctl.py 的进程 PID 与后台服务日志（本机运行态，不应入库）
deploy/runtime/

# ------------------------- IDE / 编辑器 -------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------- 测试与覆盖率 -------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------- 类型检查缓存 -------------------------
.mypy_cache/
.ruff_cache/

# ------------------------- 用户上传/剪贴板截图（非项目资产） -------------------------
IMG/

# ------------------------- TypeScript 增量编译缓存 -------------------------
*.tsbuildinfo

# ------------------------- 后端测试临时夹具（由 verify 脚本运行时生成） -------------------------
backend/storage/tmp/

# ------------------------- 临时探测文件（诊断时生成） -------------------------
backend/_tmp_probe/

# ------------------------- 本地运行态 PID 记录 -------------------------
storage/local_run_pids.json
