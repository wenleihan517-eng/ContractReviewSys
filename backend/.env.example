# D:/ContractReviewSys-合同审批智能审查项目/backend/.env.example
# =====================================================================
# 环境变量配置模板
#
# 使用方式：
#   1. 复制本文件为 .env
#   2. 按实际部署环境修改各项取值
#   3. .env 含敏感密钥，严禁提交至版本库（已在 .gitignore 中排除）
#
# 配置分组：
#   一、基础应用      二、服务监听      三、跨域配置
#   四、MongoDB       五、MinIO         六、Milvus
#   七、Embedding     八、LLM           九、文件上传
#   十、文档解析      十一、规则引擎    十二、差异化路由
#   十三、任务与重试   十四、报告导出    十五、审批系统对接
#   十六、角色与鉴权   十七、日志
# =====================================================================

# =====================================================================
# 一、基础应用
# =====================================================================
APP_NAME=企业合同智能审查系统
APP_VERSION=1.0.0
# 运行环境：dev（开发）/ test（测试）/ prod（生产）
APP_ENV=dev
# 调试模式：生产环境必须为 False
APP_DEBUG=True
# 接口统一前缀
API_V1_PREFIX=/api/v1

# =====================================================================
# 二、服务监听
# =====================================================================
SERVER_HOST=0.0.0.0
# 8000 是全机保留位（VMware vmnat.exe 抢占前科），本项目统一用 8100。
# 与 run_local.py 的 BACKEND_PORT 保持一致。
SERVER_PORT=8100
# 生产环境工作进程数
SERVER_WORKERS=4
# 代码热重载：仅开发环境为 True，生产环境必须 False
SERVER_RELOAD=True

# =====================================================================
# 三、跨域配置（JSON 数组格式，Vite 默认端口 5173）
# =====================================================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Request-Id","Accept"]

# =====================================================================
# 四、MongoDB — 业务任务 / 元数据 / 规则配置
# =====================================================================
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=contract_review
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# =====================================================================
# 五、MinIO — 合同文件资产
# =====================================================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 内网部署默认 False；启用 HTTPS 时置 True
MINIO_SECURE=False
# 存储桶：合同原件
MINIO_BUCKET_CONTRACT=contract-origin
# 存储桶：OCR 页面图片
MINIO_BUCKET_OCR_IMAGE=contract-ocr-image
# 存储桶：审查报告
MINIO_BUCKET_REPORT=contract-report
# 存储桶：标准条款库附件
MINIO_BUCKET_CLAUSE_LIB=contract-clause-lib
# 存储桶：任务临时文件（任务级目录隔离）
MINIO_BUCKET_TMP=contract-tmp

# =====================================================================
# 六、Milvus — 向量数据（复用现有实例 + 独立 database 隔离）
# =====================================================================
MILVUS_HOST=192.168.10.130
MILVUS_PORT=7000
# 本项目独立库，严禁使用 default 库（避免与其它项目集合污染）
MILVUS_DB_NAME=contract_review
# 合同条款向量集合
MILVUS_COLLECTION_CLAUSE=cr_clauses
# 标准条款库向量集合（条款推荐数据源）
MILVUS_COLLECTION_STANDARD_CLAUSE=cr_standard_clause_lib
# 规则模板向量集合（语义规则召回）
MILVUS_COLLECTION_RULE_TEMPLATE=cr_rule_templates
# 索引类型与度量方式
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_PARAMS_M=16
MILVUS_INDEX_PARAMS_EF_CONSTRUCTION=200
MILVUS_SEARCH_PARAMS_EF=128
MILVUS_TIMEOUT_SECONDS=10.0
# 向量检索返回的最大候选条数（1-50）。过大将引入噪声候选，降低人工复核效率
MILVUS_SEARCH_TOP_K=5

# =====================================================================
# 七、Embedding — BGE-M3 本地向量化服务
# =====================================================================
EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
EMBEDDING_MODEL_NAME=bge-m3
# BGE-M3 固定 1024 维，禁止修改
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=3

# =====================================================================
# 八、LLM — 本地部署，OpenAI 兼容协议
# 说明：仅承担辅助能力（语义解析 / 风险候选 / 建议初稿 / 合规解读）
#       更换底层模型只需修改 base_url 与 model_name
# =====================================================================
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=qwen2.5-14b-instruct
# 合同场景要求输出稳定，保持低温度，禁止调高
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120.0
LLM_MAX_RETRIES=2

# =====================================================================
# 九、文件上传
# =====================================================================
UPLOAD_MAX_SIZE_MB=100
# 允许的扩展名，覆盖电子合同与扫描件
UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".doc",".docx",".png",".jpg",".jpeg",".tif",".tiff"]

# =====================================================================
# 十、文档解析与 OCR
# =====================================================================
OCR_ENGINE=paddleocr
# ch 表示中英文混合识别
OCR_LANG=ch
OCR_DET_IMAGE_MAX_SIDE=2000
# OCR 平均置信度低于该阈值时判定扫描件模糊，任务进入阻塞
OCR_MIN_CONFIDENCE_THRESHOLD=0.6
# 抽取正文字符数低于该值时判定正文为空，任务进入阻塞
MIN_CONTENT_LENGTH=50
# 单页 OCR 超时时间（秒）
OCR_PAGE_TIMEOUT_SECONDS=60.0

# =====================================================================
# 十一、规则引擎（所有正式业务判定的唯一裁决方）
# =====================================================================
# 生产环境必须为 True，禁止关闭（关闭将导致系统拒绝执行审查流程）
RULE_ENGINE_ENABLED=True
RULE_ENGINE_VERSION=v1.0.0
# 触发任务阻塞的风险等级
RULE_ENGINE_BLOCK_LEVELS=["high","critical"]
# 风险等级全集，由低到高
RULE_RISK_LEVELS=["low","medium","high","critical"]
# 规则配置文件路径（相对 backend 工作目录）。规则引擎从这里加载 YAML 规则，
# 该文件缺失将导致审查流程直接拒绝执行，绝不静默放行
RULE_RULES_PATH=config/risk_rules.yaml
# 语义匹配默认阈值（规则模板未单独配置时使用）
RULE_SEMANTIC_DEFAULT_THRESHOLD=0.82
# 向量召回最低相似度门槛（0-1）。低于该值的候选在 merge 前被过滤
RULE_SEMANTIC_RECALL_MIN_SIMILARITY=0.70

# =====================================================================
# 十二、差异化流程路由
# =====================================================================
# 快速通道：模板合同（template_flag=true）走快速通道
ROUTE_FAST_ENABLED=True
# 大额阈值（元）：金额 ≥ 该值走深度复核通道
ROUTE_DEEP_AMOUNT_THRESHOLD=5000000
# 深度复核通道是否强制法务介入
ROUTE_DEEP_REQUIRE_LEGAL=True
# 强制走深度复核的合同类型（逗号分隔）
ROUTE_DEEP_FORCE_TYPES=foreign_cooperation,equity_transfer,guarantee,loan

# =====================================================================
# 十三、任务与重试机制
# =====================================================================
# 节点级最大重试次数
TASK_MAX_RETRY=3
# 指数退避基数（秒）：1s → 2s → 4s → 8s 封顶
TASK_RETRY_BASE_DELAY=1.0
# 单次退避等待上限（秒）
TASK_RETRY_MAX_DELAY=8.0
# 任务临时文件保留天数（超期清理）
TASK_TMP_RETENTION_DAYS=7
# 并发执行的最大任务数（防资源耗尽）
TASK_MAX_CONCURRENCY=5

# =====================================================================
# 十四、生成质量闭环
# =====================================================================
# 校验失败后自动修正的最大轮次
QUALITY_MAX_FIX_ROUNDS=2
# 是否启用生成前规则约束注入
QUALITY_PRECONSTRAINT_ENABLED=True
# 是否启用生成后多维校验
QUALITY_POSTCHECK_ENABLED=True
# 建议初稿的最大字符长度
SUGGESTION_MAX_LENGTH=2000

# =====================================================================
# 十五、报告导出
# =====================================================================
# 支持的报告导出格式（md = Markdown 源文本；pdf = PyMuPDF 原生绘制版式）
REPORT_FORMATS=["md","pdf"]
# 报告文件访问链接有效期（秒）
REPORT_URL_EXPIRE_SECONDS=86400
# 是否在报告中包含法务补充意见
REPORT_INCLUDE_LEGAL_OPINION=True

# ---------------------------------------------------------------------
# 十五之二、PDF 报告版式（PyMuPDF 原生绘制，零系统级依赖）
# 说明：全部尺寸单位为毫米(mm)；字号单位为磅(pt)。
#       留空的字体路径表示由渲染器自动探测系统字体，探测失败回退 PyMuPDF
#       内置 CJK 字体（china-s），保证中文永不缺字、不出现乱码。
# ---------------------------------------------------------------------
# 是否启用 PDF 报告导出（关闭后下载接口仅提供 md）
PDF_ENABLED=True
# 生成 Markdown 时是否自动联动生成 PDF（两种格式一次产出、内容天然对齐）
PDF_AUTO_WITH_MD=True
# 页眉左侧固定文字
PDF_HEADER_TEXT=合同审批智能审查系统 · 审查报告
# 页脚是否显示页码（第 X 页 / 共 Y 页）
PDF_FOOTER_SHOW_PAGE=True
# 页脚是否显示报告生成时间
PDF_FOOTER_SHOW_TIME=True
# 正文（宋体系族）字体文件绝对路径，留空=自动探测
PDF_FONT_PATH=
# 标题（黑体系族）字体文件绝对路径，留空=自动探测
PDF_FONT_PATH_BOLD=
# A4 页边距（毫米）：上 / 下 / 左 / 右
PDF_PAGE_MARGIN_TOP_MM=25.0
PDF_PAGE_MARGIN_BOTTOM_MM=22.0
PDF_PAGE_MARGIN_LEFT_MM=22.0
PDF_PAGE_MARGIN_RIGHT_MM=22.0
# 正文字号（磅），10.5pt 即中文五号字
PDF_BODY_FONT_SIZE_PT=10.5
# 表格内文字号（磅）
PDF_TABLE_FONT_SIZE_PT=9.0
# 正文行高倍数
PDF_LINE_HEIGHT_RATIO=1.6
# PDF 最大页数上限（防止异常数据导致内存耗尽）
PDF_MAX_PAGES=200

# =====================================================================
# 十六、审批系统对接（仅写入评论区，严禁改变审批结论）
# =====================================================================
# 企业审批系统基础地址
APPROVAL_BASE_URL=http://127.0.0.1:9100
# 评论接口路径（系统仅允许调用该路径，白名单硬编码在 approval_guard）
APPROVAL_COMMENT_API_PATH=/comments
# 对接鉴权密钥
APPROVAL_API_KEY=your-approval-api-key
# 请求超时时间（秒）
APPROVAL_TIMEOUT_SECONDS=30.0
# 回写失败重试次数（指数退避）
APPROVAL_MAX_RETRIES=3
# 连接与读取超时（秒）
APPROVAL_CONNECT_TIMEOUT_SECONDS=10.0
# 回写模式：formal=正式写入审批系统；preview=仅记录评论内容不实际写入。
# 开发联调阶段建议用 preview，避免污染审批系统真实数据
APPROVAL_WRITE_BACK_MODE=formal

# =====================================================================
# 十七、角色与鉴权
# =====================================================================
# 是否启用鉴权（开发阶段可关闭，生产必须开启）
AUTH_ENABLED=True
# JWT 签名密钥（生产环境务必修改为强随机值）
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
# JWT 算法
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟），默认 2 小时
JWT_EXPIRE_MINUTES=120
# 刷新令牌有效期（分钟），默认 7 天
JWT_REFRESH_EXPIRE_MINUTES=10080
# JWT 签发方标识（iss 声明）
JWT_ISSUER=contract-review-system
# bcrypt 哈希强度（轮数），12 为安全与耗时平衡点
BCRYPT_ROUNDS=12
# 承载访问令牌的请求头名称与其前缀
AUTH_TOKEN_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer
# 鉴权白名单路径（逗号分隔，命中则不校验令牌）
AUTH_WHITELIST_PATHS=/,/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/health,/api/v1/health/ready,/api/v1/health/live,/docs,/redoc,/openapi.json,/favicon.ico
# 连续登录失败锁定阈值（置 0 表示不自动锁定）
AUTH_MAX_LOGIN_FAILURES=5
# 账号锁定后的自动解锁时长（分钟）
AUTH_LOGIN_LOCK_MINUTES=30
# 角色标识：业务经办人
ROLE_BUSINESS_USER=business_user
# 角色标识：法务审查人
ROLE_LAW_USER=law_user
# 角色标识：系统管理员
ROLE_SYSTEM_ADMIN=admin
# 启动时是否初始化内置演示账号（幂等 upsert）
SEED_BUILTIN_USERS=True
# 内置演示账号初始密码（仅演示用，生产必须修改）
DEFAULT_PASSWORD=123456

# =====================================================================
# 十八、日志
# =====================================================================
# 级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
LOG_DIR=storage/logs
LOG_FILE_NAME=contract_review.log
# 日志保留天数，超期自动清理
LOG_RETENTION_DAYS=30
LOG_CONSOLE_OUTPUT=True
